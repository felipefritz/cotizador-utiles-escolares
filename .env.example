# Base de datos PostgreSQL (Neon en producción; mantener sslmode=require)
DATABASE_URL=postgresql://usuario:password@host/neondb?sslmode=require

# OAuth Google
GOOGLE_CLIENT_ID=tu_google_client_id_aqui
GOOGLE_CLIENT_SECRET=tu_google_client_secret_aqui
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# OAuth GitHub
GITHUB_CLIENT_ID=tu_github_client_id_aqui
GITHUB_CLIENT_SECRET=tu_github_client_secret_aqui
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# OAuth Twitter/X
TWITTER_CLIENT_ID=tu_twitter_client_id_aqui
TWITTER_CLIENT_SECRET=tu_twitter_client_secret_aqui
TWITTER_REDIRECT_URI=http://localhost:8000/api/auth/twitter/callback

# JWT Secret (cambiar en producción)
SECRET_KEY=tu-clave-secreta-super-segura-cambiar-en-produccion

# Frontend URL
FRONTEND_URL=http://localhost:5173

# URL pública del backend (webhooks y callbacks externos)
BACKEND_URL=http://localhost:8000

MERCADOLIBRE_SITE_ID=MLC
# Opcional si tienes OAuth/token de MercadoLibre
MERCADOLIBRE_ACCESS_TOKEN=
